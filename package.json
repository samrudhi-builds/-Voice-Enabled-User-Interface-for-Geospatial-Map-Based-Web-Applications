{
  "name": "geovoice-mvp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "TMPDIR=./tmp XDG_CACHE_HOME=./.cache NODE_COMPILE_CACHE=./tmp/node-compile-cache node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "TMPDIR=./tmp XDG_CACHE_HOME=./.cache NODE_COMPILE_CACHE=./tmp/node-compile-cache tsc --noEmit && vite build",
    "typecheck": "TMPDIR=./tmp XDG_CACHE_HOME=./.cache NODE_COMPILE_CACHE=./tmp/node-compile-cache tsc --noEmit",
    "start": "TMPDIR=./tmp XDG_CACHE_HOME=./.cache NODE_COMPILE_CACHE=./tmp/node-compile-cache node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "test": "TMPDIR=./tmp XDG_CACHE_HOME=./.cache NODE_COMPILE_CACHE=./tmp/node-compile-cache vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
